<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CS8632;CS8604;CS0169;CS0649</NoWarn>
		<DefaultItemExcludes>$(DefaultItemExcludes);tools\**</DefaultItemExcludes>
	</PropertyGroup>

	<!-- References -->
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<!-- Packaged in .tmod; TemplateInitializer copies to SavePath/TheArchitectsBlueprintMod on first launch. -->
		<AdditionalFiles Include="Content\Templates\**\*.itr" />
		<AdditionalFiles Include="Content\Templates\**\*.itr.json" />
		<EmbeddedResource Include="Content\Config\LayerOrder.json" LogicalName="TheArchitectsBlueprintMod.LayerOrder.json" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="src\tests\cases\**\*.cs" />
	</ItemGroup>

</Project>
