	PlanPhaseConfig: {
		Tooltip: Plan-phase execution and client preference policy. Server / host.

		AllowClientPreferences: {
			Label: Allow client preferences
			Tooltip: When on (default), each client's Plan clear-style preference is used; otherwise the host Style applies.
		}

		Active: {
			Label: Active
			Tooltip: When on (default), paste plans queues in budgeted ticks; when off, uses a blind one-pass build.
		}

		TickSize: {
			Label: Tick size
			Tooltip: Planning units processed per tick. Default 50.
		}

		TickSpeed: {
			Label: Tick speed
			Tooltip: Delay between planning ticks in milliseconds. Default 0.
		}

		Strategy: {
			Label: Strategy
			Tooltip: Host Plan clear-footprint style (All / Transparent / Negative).
