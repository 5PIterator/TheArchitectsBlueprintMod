UI: {
	SearchEntries: Search...
	NoPayloadEntries: No payload entries found.
	NoProjectionSelected: No projection selected
	AuthorBy: By {0}
	RefreshEntries: Refresh entries
	EditProjectName: Edit project name
	ExportReadableJsonHoverOff: Export compact .tab
	ExportReadableJsonHoverOn: Export readable .json
	OpenPayloadBrowser: Open payload browser
	PrintManifest: Print item manifest

	Manifest: {
		Header: --- Payload Manifest ---
		Empty: No placeable materials in this payload.
		NoProjection: No projection selected.
		NoPayload: Projection has no payload.
		ColItems: Items
		ColQty: Qty
		ColMissing: Missing
		ColMain: Main
		ColSources: Sources
		EntryQty: "{0}/{1}"
		EntryMissing: (-{0})
		EntryMissingPaired: (-{0}) (-{1})
		Unresolved: "{0} unresolved mapping(s):"
		Satisfied: All remaining materials are available.
	}

	Metadata: {
		dimensions: Dimensions
		createdUtc: Created
		modified: Modified
		modVersion: Mod version
		terrariaVersion: Terraria version
		modsLoaded: Mods loaded
	}

	Sort: {
		ModifiedDesc: Modified ↓
		ModifiedAsc: Modified ↑
		NameAsc: Name A–Z
		NameDesc: Name Z–A
		SizeDesc: Size ↓
	}

	Filter: {
		All: All
		ValidOnly: Valid
		InvalidOnly: Invalid
		MissingMods: Missing mods
		LegacyOnly: Legacy
	}

	Paste: {
		None: No error (internal).
		InvalidProjection: Invalid projection (missing payload or not ready to paste).
		InvalidPayload: Invalid payload for paste.
		InvalidPacket: Invalid paste request packet or send failed (wrong game mode).
		NotHost: Only host can paste in multiplayer.
		AreaLimit: Projection exceeds area limits.
		VolumeLimit: Projection exceeds tile volume limit.
		PlayerOperationLimit: Player operation limit reached.
		ServerOperationLimit: Server operation limit reached.
		AlreadyActive: Paste operation already active.
		Unsupported: Invalid or unsupported paste request.
		AckTimeout: Paste request timed out waiting for the server.
		RejectedPrefix: Paste rejected: {0}
		BlockedArea: Paste blocked: projection exceeds area limits.
		BlockedVolume: Paste blocked: projection exceeds tile volume limit.
	}
}

Items: {
	IncludeStick: {
		DisplayName: Include Stick
		Tooltip:
			'''
			Include tiles in the current selection.
			Left: drag a rectangle to include tiles
			Right: cancel the rectangle preview (release left first, or hold left + right while dragging)
			'''
	}

	ArchitectsHand: {
		DisplayName: Architect's Hand
		Tooltip:
			'''
			Late-game accessory.
			Submerge in Shimmer to obtain Architect's Blueprint.
			'''
	}

	ArchitectsBlueprint: {
		DisplayName: Architect's Blueprint
		Tooltip:
			'''
			Late-game item from shimmering Architect's Hand.
			Usable animation only — full tool behavior is not implemented yet.
			'''
	}

	ArchitectsStencil: {
		DisplayName: Architect's Stencil
		Tooltip:
			'''
			All-in-one: selection, projection, execution.
			Right: action wheel — PIN, SET, INC, EXC, COPY, PASTE, RESET
			Left: use the selected mode (RESET clears only what is under the cursor when it hits a selection or projection)
			While including/excluding tiles, right also cancels the rectangle preview.
			'''
	}

	BlueprintCore: {
		DisplayName: Blueprint Core
		Tooltip:
			'''
			Crafted at a Demon or Crimson altar from large gems, a boss-summon item, fallen stars, and wood.
			Combines with the tier-2 wands into the Architect's Stencil.
			'''
	}

	SelectionWand: {
		DisplayName: Selection Wand
		Tooltip:
			'''
			Selection bounds editing.
			Right: action wheel — PIN, SET, RESET
			Left: PIN (new pins) or SET (edit selection, or move a projection when the selection is not overlapping) depending on wheel; RESET clears only when the cursor is on the selection area
			'''
	}

	CopyStick: {
		DisplayName: Copy Stick
		Tooltip:
			'''
			Create and move a projection.
			Left: drag to place/move
			Right: cancel move while dragging; otherwise remove projection or clear selection only if the cursor hits one
			'''
	}

	ExecutionWand: {
		DisplayName: Execution Wand
		Tooltip:
			'''
			Run pastes against projections.
			Right: action wheel — PASTE, RESET
			Left: start paste or RESET hit (cursor must be on target)
			While pasting, hold left + right to cancel like the paste stick.
			'''
	}

	DebugStick: {
		DisplayName: Debug Stick
		Tooltip:
			'''
			Alt-click: debug action wheel. Left-click: apply the selected action (or advance an active step session first).
			CUT: toggle CutSource on the projection under the cursor.
			STP: start single-player stepped paste on the projection under the cursor; further left-clicks advance the paste or any discovery step session.
			Right-click: cancel step session.
			'''
	}

	PasteStick: {
		DisplayName: Paste Stick
		Tooltip:
			'''
			Paste a projection.
			Left: start pasting on the projection under the cursor
			Hold left + right: cancel an active paste
			'''
	}

	PinStick: {
		DisplayName: Pin Stick
		Tooltip:
			'''
			Start a new selection.
			Left: place & drag bounds, then release to finalize
			While dragging: hold left + right to cancel the pin gesture
			When the left button is up: right clears the active selection
			'''
	}

	ProjectionWand: {
		DisplayName: Projection Wand
		Tooltip:
			'''
			Manage projections.
			Right: action wheel — COPY, PASTE, RESET
			Left: place/move projection, start paste, or RESET hit (cursor must be on target)
			Source-clear (CUT) is toggled on the projection in-world, not on this wand.
			'''
	}

	ExcludeStick: {
		DisplayName: Exclude Stick
		Tooltip:
			'''
			Exclude tiles from the current selection.
			Left: drag a rectangle to exclude tiles
			Right: cancel the rectangle preview (release left first, or hold left + right while dragging)
			'''
	}

	InclusionWand: {
		DisplayName: Inclusion Wand
		Tooltip:
			'''
			Include or exclude tiles within a selection.
			Right: cancel active rectangle preview, or open action wheel — INC, EXC
			Left: use the mode selected on the wheel
			'''
	}
}

Configs: {
	ClientLogConfig: {
		DisplayName: Client Diagnostics
		Tooltip: These options apply only on your machine. They are not sent to the server and do not change host paste rules or map compilation.

		Headers: {
			Logging: Logging
			LogTags: Log tag families
		}

		MinimumLogLevel: {
			Label: Minimum log level
			Tooltip:
				'''
				Only records at this severity or higher are written to the mod log (and to chat when enabled).
				Debug is the most verbose; Error is the least.
				'''
		}

		TagGeneric: {
			Label: Generic
			Tooltip: Concise paste phase progress and task results ([Generic]). Shown only to the paste operation owner.
		}

		TagPaste: {
			Label: Paste
			Tooltip: Paste planning, phases, task execution, and paste lifecycle ([Paste]).
		}

		TagTileExecutor: {
			Label: TileExecutor
			Tooltip: Tile mutation queue, projectile launch/impact, and apply results ([TileExecutor]).
		}

		TagInventory: {
			Label: Inventory
			Tooltip: Inventory lookup, reserve/consume, store destination, and store attempts ([Inventory]).
		}

		TagProjection: {
			Label: Projection
			Tooltip: Projection and ProjectionSystem client state ([Projection], [ProjectionSystem]).
		}

		TagSelection: {
			Label: Selection
			Tooltip: Selection, SelectionSystem, and Blueprint client state ([Selection], [SelectionSystem], [Blueprint]).
		}

		TagLayers: {
			Label: Layers
			Tooltip: Layer registration, ordering, and custom sub-layer warnings ([Layers]).
		}

		TagTileMapping: {
			Label: Tile mapping
			Tooltip: Tile mapping compile and discovery actions ([TileMapping]).
		}

		TagInteractionMap: {
			Label: Interaction map
			Tooltip: Interaction map load and entry validation ([InteractionMap]).
		}

		TagNetworking: {
			Label: Networking
			Tooltip: Paste networking packet handling ([PasteNet]).
		}

		TagToolAction: {
			Label: Tool action
			Tooltip: Tool action manager errors ([ToolAction]).
		}

		TagTemplate: {
			Label: Template
			Tooltip: Template copy warnings ([Template]).
		}

		TagManifest: {
			Label: Manifest
			Tooltip: Paste item manifest output ([Manifest]).
		}

		TagOther: {
			Label: Other / uncategorized
			Tooltip: Log lines with no category tag or unknown tags (excluding Generic paste progress).
		}

		PrintDebugLogsToChat: {
			Label: Print debug logs to chat
			Tooltip:
				'''
				Also echo debug entries into chat when they meet the minimum log level.
				Owner-scoped paste diagnostics only appear for the local paste owner.
				Client only — other players are unaffected.
				'''
		}

		PrintInfoLogsToChat: {
			Label: Print info logs to chat
			Tooltip:
				'''
				Also echo info entries into chat when they meet the minimum log level.
				Concise paste phase results ([Generic]) appear only for the paste operation owner.
				Client only — other players are unaffected.
				'''
		}

		TagFrameLayer: {
			Label: Frame layer
			Tooltip: Frame identify/place/clear candidate tracing ([FrameLayer]).
		}
	}

	TabLogLevel: {
		Tooltip: ""

		Debug: {
			Label: Debug
			Tooltip: Verbose diagnostic detail.
		}

		Info: {
			Label: Info
			Tooltip: Concise operational progress.
		}

		Warn: {
			Label: Warn
			Tooltip: Recoverable problems and configuration issues.
		}

		Error: {
			Label: Error
			Tooltip: Failures that need attention.
		}
	}

	ClientPasteConfig: {
		DisplayName: Client Paste Preferences
		Tooltip:
			'''
			Local paste preferences sent with your paste request.
			The server decides which preferences are honored via Allow client preferences in Paste policy (server / host).
			'''

		Headers: {
			Preferences: Preferences
			Arrow: Arrow
			Debug: Debug Header
		}

		Plan: {
			Label: Plan
			Tooltip: Plan-phase strategy preference.

			Strategy: {
				Label: Strategy
				Tooltip:
					'''
					All — clear the full target footprint.
					Transparent — clear only where payload overlaps the destination.
					Negative — clear only where payload does not overlap.
					'''
			}
		}

		Clear: {
			Label: Clear
			Tooltip: Clear-phase item handling while destroying tiles.

			Strategy: {
				Label: Strategy
				Tooltip: ""

				ItemDrop: {
					Label: Item drop
					Tooltip:
						'''
						Void — destroy tiles without dropping items.
						Drop — spawn normal tile drops in the world.
						Store — route drops into adjacent inventories, dropping overflow when full or when no inventory is linked.
						'''
				}
			}
		}

		Place: {
			Label: Place
			Tooltip: Place-phase tolerance preferences.

			RetryOnMissingItems: {
				Label: Retry on missing items
				Tooltip: When enabled, place tasks that fail for lack of items are requeued. When disabled (default), those tiles are skipped during planning and at execution.
			}

			RetryOnInvalidPlacement: {
				Label: Retry on invalid placement
				Tooltip:
					'''
					When enabled, object-layer tiles retry until their support exists; other layers requeue failed placements.
					When disabled (default), tiles that cannot be placed are skipped so the paste can finish.
					Single-player and listen-host pastes use this client preference when the server allows client preferences.
					'''
			}
		}

		Arrow: {
			Label: Arrow
			Tooltip: Flight timing and velocity for paste arrows.

			Speed: {
				Label: Arrow speed
				Tooltip: How long each arrow takes to complete its flight, in ticks. Lower values are faster.
			}

			MinSpeed: {
				Label: Arrow min velocity
				Tooltip: Minimum travel speed for paste arrows.
			}

			MaxSpeed: {
				Label: Arrow max velocity
				Tooltip: Maximum travel speed for paste arrows.
			}
		}

		Overlay: {
			Label: Overlay
			Tooltip: ""
		}
	}

	PastingConfig: {
		DisplayName: Paste Policy
		Tooltip:
			'''
			In multiplayer, the host or dedicated server owns these values; joining clients see them but usually cannot change them.
			Limits and phase pacing are authoritative. Strategy defaults can optionally allow client preferences.
			'''

		Headers: {
			GlobalLimits: Global limits
			PhasePolicy: Phase policy
			LayerPolicy: Layer policy
			ProjectilePolicy: Projectile Policy Header
		}

		Limits: {
			Label: Global limits
			Tooltip: Global caps enforced for all paste phases and operations.

			Client: {
				Label: Client limits
				Tooltip: Per-client caps enforced on paste requests and during server validation.

				MaxPasteWidth: {
					Label: Max paste width
					Tooltip: Maximum projection width in tiles.
				}

				MaxPasteHeight: {
					Label: Max paste height
					Tooltip: Maximum projection height in tiles.
				}

				VolumeLimit: {
					Label: Volume limit
					Tooltip: Maximum number of cells in a single paste.
				}

				PlayerOperationLimit: {
					Label: Player operation limit
					Tooltip: Maximum concurrent paste operations per player.
				}
			}

			Server: {
				Label: Server limits
				Tooltip: Server-wide execution caps.

				ServerOperationLimit: {
					Label: Server operation limit
					Tooltip: Maximum concurrent paste operations on the server.
				}

				MaxPhaseTickSize: {
					Label: Max phase tick size
					Tooltip: Upper bound for tasks or planning units processed per tick in any phase.
				}

				MaxTilesPerCategory: {
					Label: Max tiles per category
					Tooltip: Maximum tiles processed per layer category in a single step.
				}

				MaxConcurrentArrows: {
					Label: Max concurrent arrows
					Tooltip: Maximum paste arrows in flight per operation at once.
				}
			}
		}

		Phases: {
			Label: Phase policy
			Tooltip: Per-phase execution, strategy defaults, and client preference policy.

			Plan: {
				Label: Plan
				Tooltip: Builds clear, cut, and place task queues before execution.

				Active: {
					Label: Active
					Tooltip: When off, queues are built without planning optimizations.
				}

				TickSize: {
					Label: Planning units per tick
					Tooltip: How many planning units to process per tick while building queues.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay between planning ticks. Use 0 for no wait.
				}
			}

			Clear: {
				Label: Clear
				Tooltip: Clears destination tiles before placement.

				Strategy: {
					Label: Clear strategy default
					Tooltip: Server default used when client preferences are disabled.
				}

				AllowClientPreferences: {
					Label: Allow client preferences
					Tooltip: Allow clients to override clear strategy. When disabled, server default is used.
				}

				Active: {
					Label: Active
					Tooltip: ""
				}

				TickSize: {
					Label: Tasks per tick
					Tooltip: Maximum clear tasks executed per tick.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay after each clear tick.
				}
			}

			Cut: {
				Label: Cut
				Tooltip: Clears tiles at the source area for cut-paste.

				Active: {
					Label: Active
					Tooltip: ""
				}

				TickSize: {
					Label: Tasks per tick
					Tooltip: Maximum cut tasks executed per tick.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay after each cut tick.
				}
			}

			Place: {
				Label: Place
				Tooltip: Places payload tiles at the destination.

				Strategy: {
					Label: Place strategy
					Tooltip: Place uses normal placement; Replace clears conflicting tiles before placing.
				}

				RequireItems: {
					Label: Require items
					Tooltip: Consume required items from inventory while placing.
				}

				RetryOnMissingItems: {
					Label: Retry on missing items default
					Tooltip: Server default used when client preferences are disabled.
				}

				RetryOnInvalidPlacement: {
					Label: Retry on invalid placement default
					Tooltip:
						'''
						Server default when client preferences are disabled.
						When enabled, invalid placements are retried; when disabled, they are skipped.
						'''
				}

				AllowClientPreferences: {
					Label: Allow client preferences
					Tooltip: Allow clients to override place-phase preferences. When disabled, server defaults are used.
				}

				Active: {
					Label: Active
					Tooltip: ""
				}

				TickSize: {
					Label: Tasks per tick
					Tooltip: Maximum place tasks executed per tick.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay after each place tick.
				}

				EnableCutPasteProcess: {
					Label: Force source clear during paste
					Tooltip:
						'''
						When enabled, paste always plans source-area clear tasks even if the projection source-clear flag is off.
						Server / host only in multiplayer — clients cannot force this from their own config.
						'''
				}
			}

			Sweep: {
				Label: Sweep
				Tooltip:
					'''
					Host-only footprint blit that copies payload tiles directly and skips Place.
					Off by default. When active, tick delay 0 runs the full queue in one tick.
					'''

				Active: {
					Label: Active
					Tooltip:
						'''
						When enabled, paste ends with a sweep blit over the included footprint instead of layer Place.
						Server / host only in multiplayer.
						'''
				}

				TickSize: {
					Label: Batch size
					Tooltip: Reserved for future batching; full queue runs in one tick when delay is 0.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Use 0 to apply the entire sweep queue in a single tick.
				}
			}
		}

		LayerPolicy: {
			DisplayName: Layer policy
			Tooltip: Enable or disable task identification per layer. Disabled layers queue no clear or place tasks.

			MainLayers: {
				DisplayName: Main Layers
				Tooltip: Pipeline layers that run directly in the paste queue.

				Wall: {
					Label: Wall
					Tooltip: Wall placement and removal.
				}

				Block: {
					Label: Block
					Tooltip: Standard placed tiles that are not falling, anchored, tree, or unknown tiles.
				}

				Falling: {
					Label: Falling Block
					Tooltip: Falling tiles such as sand, silt, slush, and similar blocks.
				}

				Frame: {
					Label: Frame
					Tooltip: Tiles that require nearby support such as anchors, walls, or mapped base tiles.
				}

				Entity: {
					Label: Entity
					Tooltip:
						'''
						Off by default. After Frame places host tiles, overwrite matching chest, sign, and TileEntity contents from the blueprint entity sidecar without consuming inventory for those contents.
						Replaces the old entity data cheat. Inventory-backed insert/extract via paste arrows is planned separately.
						'''
				}

				Custom: {
					Label: Custom
					Tooltip: Master switch for attributed custom handlers. Individual handler toggles are in Custom Layers.
				}

				Paint: {
					Label: Paint
					Tooltip: Tile and wall paint state.
				}

				Wiring: {
					Label: Wiring
					Tooltip: Wires and actuators.
				}

				Detail: {
					Label: Detail
					Tooltip: Slopes, half-blocks, and actuation state.
				}

				Fluid: {
					Label: Fluid
					Tooltip: Water, lava, honey, and shimmer.
				}

				Unknown: {
					Label: Unknown
					Tooltip: Unknown tile ids, usually from missing or unloaded content.
				}

				Label: Main Layers
			}

			CustomLayers: {
				DisplayName: Custom Layers
				Tooltip: Enable or disable identification for individual attributed custom handlers.

				Plant: {
					Label: Plant
					Tooltip: Surface plants and regrowth tiles (non-grass).
				}

				Vine: {
					Label: Vine
					Tooltip: Hanging and reverse vine columns.
				}

				Tree: {
					Label: Tree
					Tooltip: Trees, gem trees, and cactus.
				}

				Label: Custom Layers
			}

			Label: Layer policy
		}
	}

	ArrowPastePreference: {
		Speed: {
			Label: Arrow speed
			Tooltip: How long each arrow takes to complete its flight, in ticks. Lower values are faster.
		}

		MinSpeed: {
			Label: Arrow min velocity
			Tooltip: Minimum travel speed for paste arrows.
		}

		MaxSpeed: {
			Label: Arrow max velocity
			Tooltip: Maximum travel speed for paste arrows.
		}

		Tooltip: ""
	}

	TileMappingConfig: {
		DisplayName: Tile Mapping
		Tooltip:
			'''
			Server/host control panel for mapping discovery and compile.
			Layer toggles control which SourceMaps are included during compile.
			Action toggles are one-shot: set to true and save config to enqueue that action.
			'''

		Headers: {
			TileMapping: Source map layers
			Actions: Actions
		}

		EnablePlacementDiscovery: {
			Label: Placement
			Tooltip: When enabled, Placement.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableCustomInteractionMap: {
			Label: Custom
			Tooltip: When enabled, Custom.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableWandDiscovery: {
			Label: Wand
			Tooltip: When enabled, Wands.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableRubbleDiscovery: {
			Label: Rubble
			Tooltip: When enabled, Rubble.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnablePaintDiscovery: {
			Label: Paint
			Tooltip: When enabled, Paints.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnablePlantDiscovery: {
			Label: Plant
			Tooltip: When enabled, Plants.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableConversionDiscovery: {
			Label: Conversion
			Tooltip: When enabled, Conversion.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableBiomeConversions: {
			Label: Biome
			Tooltip: When enabled, Biome.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableShimmerTransforms: {
			Label: Shimmer
			Tooltip: When enabled, Shimmer.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		RunPlacementDiscovery: {
			Label: Run placement discovery
			Tooltip: One-shot action. Save config with this enabled to run placement discovery.
		}

		RunWandDiscovery: {
			Label: Run wand discovery
			Tooltip: One-shot action. Save config with this enabled to run wand discovery.
		}

		RunRubbleDiscovery: {
			Label: Run rubble discovery
			Tooltip: One-shot action. Save config with this enabled to run rubble discovery.
		}

		RunPaintDiscovery: {
			Label: Run paint discovery
			Tooltip: One-shot action. Save config with this enabled to run paint discovery.
		}

		RunPlantDiscovery: {
			Label: Run plant discovery
			Tooltip: One-shot action. Save config with this enabled to run plant discovery.
		}

		RunConversionDiscovery: {
			Label: Run conversion discovery
			Tooltip: One-shot action. Save config with this enabled to run conversion discovery.
		}

		RunBiomeDiscovery: {
			Label: Run biome discovery
			Tooltip: One-shot action. Save config with this enabled to run biome discovery.
		}

		RunShimmerDiscovery: {
			Label: Run shimmer discovery
			Tooltip: One-shot action. Save config with this enabled to run shimmer discovery.
		}

		RunCompileNow: {
			Label: Compile mapping now
			Tooltip: One-shot action. Save config with this enabled to compile interaction maps now.
		}

		RunFullDiscoveryAndCompile: {
			Label: Run full discovery + compile
			Tooltip: One-shot action. Save config with this enabled to run placement, wand, plant, conversion, biome, shimmer discovery, then compile.
		}
	}

	LayerPolicySettings: {
		Tooltip: ""

		Wall: {
			Label: Wall
			Tooltip: ""
