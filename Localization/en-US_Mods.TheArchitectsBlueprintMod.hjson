		}

		Entity: {
			Label: Entity
			Tooltip: Off by default. Overwrite chest, sign, and TileEntity contents from the blueprint without consuming contained items.
		}

		Custom: {
			Label: Custom
			Tooltip: Master switch for attributed custom handlers. Individual handler toggles are in Custom Layers.
		}

		Paint: {
			Label: Paint
			Tooltip: ""
		}

		Wiring: {
			Label: Wiring
			Tooltip: ""
		}

		Detail: {
			Label: Detail
			Tooltip: ""
		}

