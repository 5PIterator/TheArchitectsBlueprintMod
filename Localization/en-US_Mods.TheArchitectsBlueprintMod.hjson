Items: {
	IncludeStick: {
		DisplayName: Include Stick
		Tooltip:
			'''
			Include tiles in the current selection.
			Left: drag a rectangle to include tiles
			Right: cancel the rectangle preview (release left first, or hold left + right while dragging)
			'''
	}

	ArchitectsHand: {
		DisplayName: Architect's Hand
		Tooltip:
			'''
			Late-game accessory.
			Submerge in Shimmer to obtain Architect's Blueprint.
			'''
	}

	ArchitectsBlueprint: {
		DisplayName: Architect's Blueprint
		Tooltip:
			'''
			Late-game item from shimmering Architect's Hand.
			Usable animation only — full tool behavior is not implemented yet.
			'''
	}

	ArchitectsStencil: {
		DisplayName: Architect's Stencil
		Tooltip:
			'''
			All-in-one: selection, projection, execution.
			Right: action wheel — PIN, SET, INC, EXC, COPY, PASTE, RESET
			Left: use the selected mode (RESET clears only what is under the cursor when it hits a selection or projection)
			While including/excluding tiles, right also cancels the rectangle preview.
			'''
	}

	BlueprintCore: {
		DisplayName: Blueprint Core
		Tooltip:
			'''
			Crafted at a Demon or Crimson altar from large gems, a boss-summon item, fallen stars, and wood.
			Combines with the tier-2 wands into the Architect's Stencil.
			'''
	}

	SelectionWand: {
		DisplayName: Selection Wand
		Tooltip:
			'''
			Selection bounds editing.
			Right: action wheel — PIN, SET, RESET
			Left: PIN (new pins) or SET (edit handles) depending on wheel; RESET clears only when the cursor is on the selection area
			'''
	}

	CopyStick: {
		DisplayName: Copy Stick
		Tooltip:
			'''
			Create and move a projection.
			Left: drag to place/move
			Right: cancel move while dragging; otherwise remove projection or clear selection only if the cursor hits one
			'''
	}

	ExecutionWand: {
		DisplayName: Execution Wand
		Tooltip:
			'''
			Run pastes against projections.
			Right: action wheel — PASTE, RESET
			Left: start paste or RESET hit (cursor must be on target)
			While pasting, hold left + right to cancel like the paste stick.
			'''
	}

	DebugStick: {
		DisplayName: Debug Stick
		Tooltip:
			'''
			Alt-click: debug action wheel. Left-click: apply the selected action (or advance an active step session first).
			CUT: toggle CutSource on the projection under the cursor.
			STP: start single-player stepped paste on the projection under the cursor; further left-clicks advance the paste or any discovery step session.
			Right-click: cancel step session.
			'''
	}

	PasteStick: {
		DisplayName: Paste Stick
		Tooltip:
			'''
			Paste a projection.
			Left: start pasting on the projection under the cursor
			Hold left + right: cancel an active paste
			'''
	}

	PinStick: {
		DisplayName: Pin Stick
		Tooltip:
			'''
			Start a new selection.
			Left: place & drag bounds, then release to finalize
			While dragging: hold left + right to cancel the pin gesture
			When the left button is up: right clears the active selection
			'''
	}

	ProjectionWand: {
		DisplayName: Projection Wand
		Tooltip:
			'''
			Manage projections.
			Right: action wheel — COPY, PASTE, RESET
			Left: place/move projection, start paste, or RESET hit (cursor must be on target)
			Source-clear (CUT) is toggled on the projection in-world, not on this wand.
			'''
	}

	ExcludeStick: {
		DisplayName: Exclude Stick
		Tooltip:
			'''
			Exclude tiles from the current selection.
			Left: drag a rectangle to exclude tiles
			Right: cancel the rectangle preview (release left first, or hold left + right while dragging)
			'''
	}

	InclusionWand: {
		DisplayName: Inclusion Wand
		Tooltip:
			'''
			Include or exclude tiles within a selection.
			Right: cancel active rectangle preview, or open action wheel — INC, EXC
			Left: use the mode selected on the wheel
			'''
	}
}

Configs: {
	ClientLogConfig: {
		DisplayName: Client diagnostics
		Tooltip: These options apply only on your machine. They are not sent to the server and do not change host paste rules or map compilation.
		Headers.Logging: Logging

		PrintDebugLogsToChat: {
			Label: Print debug logs to chat
			Tooltip:
				'''
				Debug logs are always written to the mod log.
				Enable this to also print debug entries into chat.
				Client only — other players are unaffected.
				'''
		}

		PrintInfoLogsToChat: {
			Label: Print info logs to chat
			Tooltip:
				'''
				Info logs are always written to the mod log.
				Enable this to print concise paste phase results to chat.
				Client only — other players are unaffected.
				'''
		}
	}

	ClientPasteConfig: {
		DisplayName: Client paste preferences
		Tooltip:
			'''
			Local paste preferences sent with your paste request.
			The server decides which preferences are honored via Allow client preferences in Paste policy (server / host).
			'''
		Headers.Preferences: Preferences

		Clear: {
			Label: Clear
			Tooltip: Clear-phase strategy preference.

			Strategy: {
				Label: Strategy
				Tooltip:
					'''
					All — clear the full target footprint.
					Transparent — clear only where payload overlaps the destination.
					Negative — clear only where payload does not overlap.
					'''
			}
		}

		Place: {
			Label: Place
			Tooltip: Place-phase tolerance preferences.

			IgnoreMissingItems: {
				Label: Ignore missing items
				Tooltip: When enabled (default), placement is not queued where required items are missing, and place steps that fail for lack of items are treated as complete.
			}

			IgnoreInvalidPlacement: {
				Label: Ignore invalid placement
				Tooltip: When enabled (default), placement is not queued where the tile cannot be placed by world/rules, and place steps that fail for invalid placement are treated as complete.
			}
		}

		Sweep: {
			Label: Sweep
			Tooltip: Sweep-phase strategy preference.

			Strategy: {
				Label: Strategy
				Tooltip:
					'''
					Detail — normal sweep behavior.
					Cheat — use forced placement where supported.
					'''
			}
		}
	}

	PastingConfig: {
		DisplayName: Paste policy (server / host)
		Tooltip:
			'''
			In multiplayer, the host or dedicated server owns these values; joining clients see them but usually cannot change them.
			Limits and phase pacing are authoritative. Strategy defaults can optionally allow client preferences.
			'''

		Headers: {
			Limits: Limits
			PhaseExecution: Phase execution
			ClearPolicy: Clear policy
			PlacePolicy: Place policy
			SweepPolicy: Sweep policy
			Advanced: Advanced
			LayerPolicy: Layer policy
		}

		Limits: {
			Label: Limits
			Tooltip: Global caps enforced for all paste phases and operations.

			MaxPasteWidth: {
				Label: Max paste width
				Tooltip: Maximum projection width in tiles.
			}

			MaxPasteHeight: {
				Label: Max paste height
				Tooltip: Maximum projection height in tiles.
			}

			VolumeLimit: {
				Label: Volume limit
				Tooltip: Maximum number of cells in a single paste.
			}

			PlayerOperationLimit: {
				Label: Player operation limit
				Tooltip: Maximum concurrent paste operations per player.
			}

			ServerOperationLimit: {
				Label: Server operation limit
				Tooltip: Maximum concurrent paste operations on the server.
			}

			MaxPhaseTickSize: {
				Label: Max phase tick size
				Tooltip: Upper bound for tasks or planning units processed per tick in any phase.
			}
		}

		LayerPolicy: {
			DisplayName: Layer policy
			Tooltip: Enable or disable task identification per layer. Disabled layers queue no clear or place tasks.

			Wall: {
				Label: Wall
				Tooltip: Wall placement and removal.
			}

			Block: {
				Label: Block
				Tooltip: Standard placed tiles that are not falling, anchored, tree, or unknown tiles.
			}

			FallBlock: {
				Label: Falling Block
				Tooltip: Falling tiles such as sand, silt, slush, and similar blocks.
			}

			TileAnchored: {
				Label: Tile Anchored
				Tooltip: Multi-tiles anchored to solid tiles.
			}

			WallAnchored: {
				Label: Wall Anchored
				Tooltip: Multi-tiles anchored to walls.
			}

			OtherAnchored: {
				Label: Other Anchored
				Tooltip: Multi-tiles that use other anchor rules such as plants or alternate supports.
			}

			Tree: {
				Label: Tree
				Tooltip: Trees and similar custom tile families handled by the tree layer.
			}

			Paint: {
				Label: Paint
				Tooltip: Tile and wall paint state.
			}

			Wiring: {
				Label: Wiring
				Tooltip: Wires and actuators.
			}

			Detail: {
				Label: Detail
				Tooltip: Slopes, half-blocks, and actuation state.
			}

			Fluid: {
				Label: Fluid
				Tooltip: Water, lava, honey, and shimmer.
			}

			Unknown: {
				Label: Unknown
				Tooltip: Unknown tile ids, usually from missing or unloaded content.
			}

			Label: Layer policy
		}

		Plan: {
			Label: Plan
			Tooltip: Builds clear, cut, and place task queues before execution.

			Active: {
				Label: Active
				Tooltip: When off, queues are built without planning optimizations.
			}

			TickSize: {
				Label: Planning units per tick
				Tooltip: How many planning units to process per tick while building queues.
			}

			TickDelayMs: {
				Label: Tick delay (ms)
				Tooltip: Delay between planning ticks. Use 0 for no wait.
			}
		}

		Clear: {
			Label: Clear
			Tooltip: Clears destination tiles before placement.

			Strategy: {
				Label: Clear strategy default
				Tooltip: Server default used when client preferences are disabled.
			}

			AllowClientPreferences: {
				Label: Allow client preferences
				Tooltip: Allow clients to override clear strategy. When disabled, server default is used.
			}

			Active: {
				Label: Active
				Tooltip: ""
			}

			TickSize: {
				Label: Tasks per tick
				Tooltip: Maximum clear tasks executed per tick.
			}

			TickDelayMs: {
				Label: Tick delay (ms)
				Tooltip: Delay after each clear tick.
			}
		}

		Cut: {
			Label: Cut
			Tooltip: Clears tiles at the source area for cut-paste.

			Active: {
				Label: Active
				Tooltip: ""
			}

			TickSize: {
				Label: Tasks per tick
				Tooltip: Maximum cut tasks executed per tick.
			}

			TickDelayMs: {
				Label: Tick delay (ms)
				Tooltip: Delay after each cut tick.
			}
		}

		Place: {
			Label: Place
			Tooltip: Places payload tiles at the destination.

			Strategy: {
				Label: Place strategy
				Tooltip: Place uses normal placement; Replace clears conflicting tiles before placing.
			}

			RequireItems: {
				Label: Require items
				Tooltip: Consume required items from inventory while placing.
			}

			IgnoreMissingItems: {
				Label: Ignore missing items default
				Tooltip: Server default used when client preferences are disabled.
			}

			IgnoreInvalidPlacement: {
				Label: Ignore invalid placement default
				Tooltip: Server default used when client preferences are disabled.
			}

			AllowClientPreferences: {
				Label: Allow client preferences
				Tooltip: Allow clients to override place-phase preferences. When disabled, server defaults are used.
			}

			Active: {
				Label: Active
				Tooltip: ""
			}

			TickSize: {
				Label: Tasks per tick
				Tooltip: Maximum place tasks executed per tick.
			}

			TickDelayMs: {
				Label: Tick delay (ms)
				Tooltip: Delay after each place tick.
			}
		}

		Sweep: {
			Label: Sweep
			Tooltip: Final footprint sweep. Tick delay 0 runs the full queue in one tick.

			Strategy: {
				Label: Sweep strategy default
				Tooltip: Server default used when client preferences are disabled.
			}

			AllowClientPreferences: {
				Label: Allow client preferences
				Tooltip: Allow clients to override sweep strategy. When disabled, server default is used.
			}

			Active: {
				Label: Active
				Tooltip: ""
			}

			TickSize: {
				Label: Batch size
				Tooltip: Reserved for future batching; full queue runs in one tick when delay is 0.
			}

			TickDelayMs: {
				Label: Tick delay (ms)
				Tooltip: Use 0 to apply the entire sweep queue in a single tick.
			}
		}

		EnableCutPasteProcess: {
			Label: Force source clear during paste
			Tooltip:
				'''
				When enabled, paste always plans source-area clear tasks even if the projection source-clear flag is off.
				Server / host only in multiplayer — clients cannot force this from their own config.
				'''
		}
	}

	TileMappingConfig: {
		DisplayName: Tile mapping compile (server / host)
		Tooltip:
			'''
			Controls which SourceMaps layers are merged when compiling interaction maps. In multiplayer, the host or dedicated server owns these toggles.
			Use Client diagnostics and Client paste for per-machine log and planning preferences.
			'''
		Headers.TileMapping: Compile layers

		EnablePlacementDiscovery: {
			Label: Placement
			Tooltip: When enabled, Placement.itr from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableCustomInteractionMap: {
			Label: Custom
			Tooltip: When enabled, Custom.itr from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableBiomeConversions: {
			Label: Biome
			Tooltip: When enabled, Biome.itr from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableShimmerTransforms: {
			Label: Shimmer
			Tooltip: When enabled, Shimmer.itr from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}
	}

	LayerPolicySettings: {
