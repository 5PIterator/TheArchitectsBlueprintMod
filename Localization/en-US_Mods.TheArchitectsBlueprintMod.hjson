		}
	}

	CutPhaseStrategies: {
		Tooltip: Cut-phase host strategy. Clients cannot override.

		EnableCutPasteProcess: {
			Label: Force source clear during paste
			Tooltip:
				'''
				When enabled, paste always plans source-area clear tasks even if the projection Cut flag is off.
				When disabled (default), source clear runs only when the projection requests cut.
				'''
		}
	}

	PlaceStyle: {
		Tooltip: Place vs Replace placement mode. Default Place.

		Place: {
			Label: Place
			Tooltip: Normal placement without forced replace clears. Default.
		}

		Replace: {
			Label: Replace
			Tooltip: Clear conflicting tiles before placing.
		}
	}

	LogCategoryFilter: {
		Tooltip: Legacy log category filter enum. Prefer Client Diagnostics tag toggles.

		All: {
			Label: All
			Tooltip: Include every log category.
		}

		TileExecutorOnly: {
			Label: Tile executor only
			Tooltip: Restrict logging to TileExecutor lines.
		}
	}

	ProjectionPreviewPreference: {
		Tooltip: Client-only projection world-preview quality. Host does not own these settings.

		UseCachedBlit: {
			Label: Cached blit
			Tooltip: When enabled (default), bake visible preview chunks once and reuse while panning.
		}

		NearbyOnly: {
			Label: Nearby only
			Tooltip: When enabled, only draw within Nearby radius of the player. Default off.
		}

		NearbyRadiusTiles: {
			Label: Nearby radius tiles
			Tooltip: Chebyshev tile radius used when Nearby only is enabled. Default 48.
		}
	}

	BlueprintSafeguardPreference: {
		Tooltip: Client copy/paste reach and map-exploration prefs. Honored when the host allows safeguard preferences.

		RestrictCopyAndPasteToRevealedTiles: {
			Label: Require explored map tiles
			Tooltip: When enabled (default), copy and paste fail on unexplored map tiles.
		}

		LimitCopyAndPasteToPlayerReach: {
			Label: Limit to player reach
			Tooltip: When enabled (default), copy and paste fail beyond Max reach distance.
		}

		MaxReachDistanceTiles: {
			Label: Max reach distance
			Tooltip: Chebyshev tile distance from the player. Default 200. Clamped by the host cap.
		}
	}

	ArrowPastePreference: {
		Tooltip: Client arrow flight preferences sent with each paste request.

		Speed: {
			Label: Arrow speed
			Tooltip: How long each arrow takes to complete its flight, in ticks. Lower is faster. Default 48.
		}

		MinSpeed: {
			Label: Arrow min velocity
			Tooltip: Minimum travel speed for paste arrows. Default 2.5.
		}

		MaxSpeed: {
			Label: Arrow max velocity
			Tooltip: Maximum travel speed for paste arrows. Default 24.
		}
	}
}

Projectiles.PasteArrow.DisplayName: Paste Arrow
