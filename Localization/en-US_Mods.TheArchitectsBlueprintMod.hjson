UI: {
	SearchEntries: Search...
	NoPayloadEntries: No payload entries found.
	NoProjectionSelected: No projection selected
	AuthorBy: By {0}
	RefreshEntries: Refresh entries
	EditProjectName: Edit project name
	ExportReadableJsonHoverOff: Export compact .tab
	ExportReadableJsonHoverOn: Export readable .json
	ExportFormatCompactTab: Compact .tab
	ExportFormatReadableJson: Readable .json
	OpenPayloadBrowser: Open payload browser
	PrintManifest: Print item manifest
	ToggleCut: Toggle cut from source
	BrowserRevert: Revert
	BrowserApply: Apply
	BrowserExport: Export
	BrowserRevertHover: Revert the pending import preview
	BrowserApplyHover: Apply the previewed payload to the projection
	BrowserExportHover: Export the active projection payload
	BrowserStatusRefreshed: Entries refreshed.
	BrowserStatusPreviewReady: Preview ready — Apply to keep, Revert to discard.
	BrowserStatusPreviewFailed: Preview failed.
	BrowserStatusReverted: Preview reverted.
	BrowserStatusApplied: Import applied to projection.
	BrowserStatusApplyFailed: Apply failed.
	BrowserStatusExported: Payload exported.
	BrowserStatusExportFailed: Export failed.

	ArchitectMode: {
		Header: Architect Mode — {0}
		EntryOpen: Architect Mode
		EntryClose: Close Architect Mode
		UnlockChat: Architect's Blueprint GUI permanently unlocked.
		AlreadyUnlocked: Architect Mode is already unlocked.
		PanicNeedsWorld: Enter a world before clearing permanent Architect Mode unlock.
		PanicCleared: Permanent Architect Mode unlock cleared for this character.
		PanicAlreadyCleared: This character did not have a permanent Architect Mode unlock.

		Toolbar: {
			Pin: Pin selection (PIN)
			Set: Edit selection (SET)
			Include: Include tiles (INC)
			Exclude: Exclude tiles (EXC)
			Copy: Copy projection (CPY)
			Paste: Paste projection (PST)
			Cut: Toggle cut from source (CUT)
			Exit: Exit Architect Mode
		}
	}

	Manifest: {
		Header: --- Payload Manifest ---
		Empty: No placeable materials in this payload.
		NoProjection: No projection selected.
		NoPayload: Projection has no payload.
		ColItems: Items
		ColQty: Qty
		ColMissing: Missing
		ColMain: Main
		ColSources: Sources
		EntryQty: "{0}/{1}"
		EntryMissing: (-{0})
		EntryMissingPaired: (-{0}) (-{1})
		Unresolved: "{0} unresolved mapping(s):"
		Satisfied: All remaining materials are available.
		NextPage: "[Next page ({0}/{1})]"
		PageEnd: (End of manifest — page {0}/{1})
	}

	Metadata: {
		dimensions: Dimensions
		createdUtc: Created
		modified: Modified
		modVersion: Mod version
		terrariaVersion: Terraria version
		modsLoaded: Mods loaded
		missingMods: Missing mods
	}

	Sort: {
		ModifiedDesc: Modified ↓
		ModifiedAsc: Modified ↑
		NameAsc: Name A–Z
		NameDesc: Name Z–A
		SizeDesc: Size ↓
	}

	Filter: {
		All: All
		ValidOnly: Valid
		InvalidOnly: Invalid
		MissingMods: Missing mods
		LegacyOnly: Legacy
	}

	Paste: {
		None: No error (internal).
		InvalidProjection: Invalid projection (missing payload or not ready to paste).
		InvalidPayload: Invalid payload for paste.
		InvalidPacket: Invalid paste request packet or send failed.
		AreaLimit: Projection exceeds area limits.
		VolumeLimit: Projection exceeds tile volume limit.
		PlayerOperationLimit: Player operation limit reached.
		ServerOperationLimit: Server operation limit reached.
		AlreadyActive: Paste operation already active.
		Unsupported: Invalid or unsupported paste request.
		AckTimeout: Paste request timed out waiting for the server.
		RejectedPrefix: Paste rejected: {0}
		BlockedArea: Paste blocked: projection exceeds area limits.
		BlockedVolume: Paste blocked: projection exceeds tile volume limit.
		OutOfWorldTiles: Paste blocked: projection targets tiles outside the world.
		UnrevealedTiles: Paste blocked: projection targets unexplored map tiles.
		OutOfRange: Paste blocked: projection is beyond player reach.
	}

	Copy: {
		BlockedOutOfWorld: Copy blocked: selection includes tiles outside the world.
		BlockedUnrevealed: Copy blocked: selection includes unexplored map tiles.
		BlockedOutOfRange: Copy blocked: selection is beyond player reach.
	}
}

Items: {
	IncludeStick: {
		DisplayName: Include Stick
		Tooltip:
			'''
			Include tiles in the selection or projection.
			Left: drag a rectangle to include tiles
			Right: cancel the rectangle preview
			'''
	}

	ArchitectsHand: {
		DisplayName: Architect's Hand
		Tooltip:
			'''
			Enables Architect Mode while equipped.
			Crafting is disabled until Architect Mode is more stable (cheat-spawn for testing).
			'''
	}

	ArchitectsBlueprint: {
		DisplayName: Architect's Blueprint
		Tooltip:
			'''
			Permanently unlocks Architect Mode.
			Crafting and shimmer upgrade are disabled until Architect Mode is more stable (cheat-spawn for testing).
			'''
	}

	ArchitectsStencil: {
		DisplayName: Architect's Stencil
		Tooltip:
			'''
			All blueprint actions in one tool.
			Right: action wheel — PIN, SET, INC, EXC, COPY, PASTE, RESET
			Left: use the selected mode (RESET clears what is under the cursor)
			While including or excluding tiles, right also cancels the rectangle preview.
			'''
	}

	BlueprintCore: {
		DisplayName: Blueprint Core
		Tooltip: Core material for advanced blueprint tools.
	}

	SelectionWand: {
		DisplayName: Selection Wand
		Tooltip:
			'''
			Edit selection bounds.
			Right: action wheel — PIN, SET, RESET
			Left: use the selected mode (RESET clears what is under the cursor)
			'''
	}

	CopyStick: {
		DisplayName: Copy Stick
		Tooltip:
			'''
			Create and move a projection.
			Left: drag to place or move
			Right: remove the projection under the cursor
			'''
	}

	ExecutionWand: {
		DisplayName: Execution Wand
		Tooltip:
			'''
			Run pastes against projections.
			Right: action wheel — PASTE, RESET
			Left: start paste or RESET hit (cursor must be on target)
			While pasting, hold left + right to cancel like the paste stick.
			'''
	}

	DebugStick: {
		DisplayName: Debug Stick
		Tooltip:
			'''
			Debug and step-through helpers.
			Right: action wheel — CUT, STP, CHM
			Left: apply selected mode, or advance a step session
			CHM: set the universal test chamber origin at the cursor
			Right-click cancels an active step session.
			'''
	}

	PasteStick: {
		DisplayName: Paste Stick
		Tooltip:
			'''
			Paste a projection.
			Left: start pasting on the projection under the cursor
			Hold left + right: cancel an active paste
			'''
	}

	PinStick: {
		DisplayName: Pin Stick
		Tooltip:
			'''
			Start a new selection with two pins.
			Left: place pin B, drag bounds, release to finalize
			Right: RESET the selection
			While dragging: hold left + right to cancel
			'''
	}

	ProjectionWand: {
		DisplayName: Projection Wand
		Tooltip:
			'''
			Manage projections.
			Right: action wheel — COPY, PASTE, RESET
			Left: use the selected mode (RESET clears what is under the cursor)
			CUT is toggled on the projection overlay, not this wand.
			'''
	}

	ExcludeStick: {
		DisplayName: Exclude Stick
		Tooltip:
			'''
			Exclude tiles from the selection or projection.
			Left: drag a rectangle to exclude tiles
			Right: cancel the rectangle preview
			'''
	}

	InclusionWand: {
		DisplayName: Inclusion Wand
		Tooltip:
			'''
			Refine the tile mask in a selection.
			Right: action wheel — INCLUDE, EXCLUDE
			Left: drag a rectangle with the selected mode
			Hold left + right: cancel the rectangle preview
			'''
	}
}

Configs: {
	ClientLogConfig: {
		DisplayName: Client Diagnostics
		Tooltip: These options apply only on your machine. They are not sent to the server and do not change host paste rules or map compilation.

		Headers: {
			Logging: Logging
			LogTags: Log tag families
		}

		MinimumLogLevel: {
			Label: Minimum log level
			Tooltip:
				'''
				Only records at this severity or higher are written to the mod log.
				Off silences every severity. Debug is the most verbose; Error is the least.
				Chat echo is controlled separately by Minimum chat log level.
				Client only. Default: Debug.
				'''
		}

		MinimumChatLogLevel: {
			Label: Minimum chat log level
			Tooltip:
				'''
				Also echo records at this severity or higher into chat (after the minimum log level and tag filters).
				Off disables diagnostic chat echo. Owner-scoped paste lines appear only for the local paste owner.
				Client only. Default: Off.
				'''
		}

		TagGeneric: {
			Label: Generic
			Tooltip: Concise paste phase progress and task results ([Generic]). Shown only to the paste operation owner.
		}

		TagPaste: {
			Label: Paste
			Tooltip: Paste planning, phases, task execution, and paste lifecycle ([Paste]).
		}

		TagTileExecutor: {
			Label: TileExecutor
			Tooltip: Tile mutation queue, projectile launch/impact, and apply results ([TileExecutor]).
		}

		TagInventory: {
			Label: Inventory
			Tooltip: Inventory lookup, reserve/consume, store destination, and store attempts ([Inventory]).
		}

		TagProjection: {
			Label: Projection
			Tooltip: Projection and ProjectionSystem client state ([Projection], [ProjectionSystem]).
		}

		TagSelection: {
			Label: Selection
			Tooltip: Selection, SelectionSystem, and Blueprint client state ([Selection], [SelectionSystem], [Blueprint]).
		}

		TagLayers: {
			Label: Layers
			Tooltip: Layer registration, ordering, and custom sub-layer warnings ([Layers]).
		}

		TagTileMapping: {
			Label: Tile mapping
			Tooltip: Tile mapping compile and discovery actions ([TileMapping]).
		}

		TagInteractionMap: {
			Label: Interaction map
			Tooltip: Interaction map load and entry validation ([InteractionMap]).
		}

		TagNetworking: {
			Label: Networking
			Tooltip: Paste networking packet handling ([PasteNet]).
		}

		TagToolAction: {
			Label: Tool action
			Tooltip: Tool action manager errors ([ToolAction]).
		}

		TagTemplate: {
			Label: Template
			Tooltip: Template copy warnings ([Template]).
		}

		TagManifest: {
			Label: Manifest
			Tooltip: Paste item manifest output ([Manifest]).
		}

		TagOther: {
			Label: Other / uncategorized
			Tooltip: Log lines with no category tag or unknown tags (excluding Generic paste progress).
		}

		TagFrameLayer: {
			Label: Frame layer
			Tooltip: Frame identify/place/clear candidate tracing ([FrameLayer]).
		}
	}

	TabLogLevel: {
		Tooltip:
			'''
			Severity floor for Client Diagnostics.
			Off disables the floor. Debug is most verbose; Error is least.
			'''

		Off: {
			Label: Off
			Tooltip: Disable this floor — no emission for Minimum log level, or no chat echo for Minimum chat log level.
		}

		Debug: {
			Label: Debug
			Tooltip: Verbose diagnostic detail.
		}

		Info: {
			Label: Info
			Tooltip: Concise operational progress.
		}

		Warn: {
			Label: Warn
			Tooltip: Recoverable problems and configuration issues.
		}

		Error: {
			Label: Error
			Tooltip: Failures that need attention.
		}
	}

	ClientPasteConfig: {
		DisplayName: Client Paste Preferences
		Tooltip:
			'''
			Local paste preferences sent with your paste request.
			The server decides which preferences are honored via Allow client preferences / Allow client safeguard preferences in Paste policy (server / host).
			'''

		Headers: {
			Preferences: Preferences
			Safeguards: Safeguards
			Arrow: Arrow
			Preview: Preview
			Debug: Debug
		}

		Plan: {
			Label: Plan
			Tooltip: Plan-phase strategy preference.

			Strategy: {
				Label: Strategy
				Tooltip:
					'''
					All — clear the full target footprint.
					Transparent — clear only where payload overlaps the destination.
					Negative — clear only where payload does not overlap.
					'''
			}
		}

		Clear: {
			Label: Clear
			Tooltip: Clear-phase item handling while destroying tiles. Client preference; honored when the host allows clear preferences.

			Strategy: {
				Label: Strategy
				Tooltip:
					'''
					Chooses how destroyed tiles handle item drops during Clear.
					Client only when Allow client preferences is on for Clear. Default: Void.
					'''

				ItemDrop: {
					Label: Item drop
					Tooltip:
						'''
						Void — destroy tiles without dropping items (default).
						Drop — spawn normal tile drops in the world.
						Store — route drops into adjacent inventories, dropping overflow when full or when no inventory is linked.
						'''
				}
			}
		}

		Place: {
			Label: Place
			Tooltip: Place-phase tolerance preferences. Client only when the host allows place preferences.

			Strategy: {
				Label: Strategy
				Tooltip: Place-phase retry toggles sent with each paste request.

				RetryOnMissingItems: {
					Label: Retry on missing items
					Tooltip: When enabled, place tasks that fail for lack of items are requeued. When disabled (default), those tiles are skipped during planning and at execution.
				}

				RetryOnInvalidPlacement: {
					Label: Retry on invalid placement
					Tooltip:
						'''
						When enabled, object-layer tiles retry until their support exists; other layers requeue failed placements.
						When disabled (default), tiles that cannot be placed are skipped so the paste can finish.
						Single-player and listen-host pastes use this client preference when the server allows client preferences.
						'''
				}
			}
		}

		Safeguards: {
			Label: Safeguards
			Tooltip:
				'''
				Local copy/paste reach and map-exploration limits.
				Honored when Paste policy → Client limits → Allow client safeguard preferences is on; otherwise the host defaults apply.
				Out-of-world tiles are always blocked. Reveal checks use your explored map (strongest in single-player / listen-server).
				'''

			RestrictCopyAndPasteToRevealedTiles: {
				Label: Require explored map tiles
				Tooltip:
					'''
					When enabled (default), copy and paste fail if any included cell is on an unexplored map tile.
					Client preference; host may override via Paste policy client limits.
					'''
			}

			LimitCopyAndPasteToPlayerReach: {
				Label: Limit to player reach
				Tooltip:
					'''
					When enabled (default), copy and paste fail if any included cell is farther than Max reach distance from the player.
					Client preference; host may override and always clamps reach to Max reach distance cap.
					'''
			}

			MaxReachDistanceTiles: {
				Label: Max reach distance (tiles)
				Tooltip:
					'''
					Chebyshev tile distance from the player center when player reach limit is enabled.
					Default 200. Clamped by the host Max reach distance cap (default 5000).
					'''
			}
		}

		Arrow: {
			Label: Arrow
			Tooltip: Flight timing and velocity for paste arrows. Client only; sent with each paste request.

			Speed: {
				Label: Arrow speed
				Tooltip: How long each arrow takes to complete its flight, in ticks. Lower values are faster. Default 48.
			}

			MinSpeed: {
				Label: Arrow min velocity
				Tooltip: Minimum travel speed for paste arrows. Default 2.5.
			}

			MaxSpeed: {
				Label: Arrow max velocity
				Tooltip: Maximum travel speed for paste arrows. Default 24.
			}
		}

		Preview: {
			Label: Projection preview
			Tooltip:
				'''
				Client-only world ghost drawing for large projections.
				Cached blit and nearby-only mode reduce lag on massive payloads; the host does not own these settings.
				'''

			UseCachedBlit: {
				Label: Cached blit
				Tooltip:
					'''
					When enabled (default), the world projection preview bakes visible 64×64 tile chunks once and reuses them while panning.
					When disabled, every frame redraws layers for the visible clip (slower on large modded payloads).
					'''
			}

			NearbyOnly: {
				Label: Nearby only
				Tooltip:
					'''
					When enabled, the world projection preview only draws within Nearby radius tiles of the player (intersected with the screen).
					When disabled (default), the full on-screen projection footprint is drawn.
					'''
			}

			NearbyRadiusTiles: {
				Label: Nearby radius
				Tooltip: Chebyshev tile radius around the player used when Nearby only is enabled. Default 48.
			}
		}

		Overlay: {
			Label: Overlay
			Tooltip:
				'''
				Client-only paste overlay debug visuals.
				Does not affect paste results. Default: rect borders off.
				'''

			RectBorders: {
				Label: Rect borders
				Tooltip: When enabled, draws debug rectangle borders on paste overlays. Client only. Default off.
			}
		}
	}

	PastingConfig: {
		DisplayName: Paste Policy
		Tooltip:
			'''
			In multiplayer, the host or dedicated server owns these values; joining clients see them but usually cannot change them.
			Limits and phase pacing are authoritative. Strategy defaults can optionally allow client preferences.
			'''

		Headers: {
			GlobalLimits: Global limits
			PhasePolicy: Phase policy
			LayerPolicy: Layer policy
		}

		Limits: {
			Label: Global limits
			Tooltip: Global caps enforced for all paste phases and operations. Server / host owned in multiplayer.

			Client: {
				Label: Client limits
				Tooltip: Per-client caps and safeguard gates enforced on paste requests and during server validation. Server / host owned.

				MaxPasteWidth: {
					Label: Max paste width
					Tooltip: Maximum projection width in tiles. Server / host. Default 200.
				}

				MaxPasteHeight: {
					Label: Max paste height
					Tooltip: Maximum projection height in tiles. Server / host. Default 200.
				}

				VolumeLimit: {
					Label: Volume limit
					Tooltip: Maximum number of cells in a single paste. Server / host. Default 5000.
				}

				PlayerOperationLimit: {
					Label: Player operation limit
					Tooltip: Maximum concurrent paste operations per player. Server / host. Default 1.
				}

				AllowClientSafeguardPreferences: {
					Label: Allow client safeguard preferences
					Tooltip:
						'''
						When enabled (default), each client's Safeguards prefs (reach / reveal) are honored and clamped by Max reach distance cap.
						When disabled, the host defaults below are used for every player.
						Server / host only in multiplayer.
						'''
				}

				RestrictCopyAndPasteToRevealedTiles: {
					Label: Require explored map tiles (host default)
					Tooltip:
						'''
						Host default when Allow client safeguard preferences is off.
						When enabled (default), copy and paste fail on unexplored map tiles.
						Reveal checks use each player's explored map (strongest in single-player / listen-server).
						'''
				}

				LimitCopyAndPasteToPlayerReach: {
					Label: Limit to player reach (host default)
					Tooltip:
						'''
						Host default when Allow client safeguard preferences is off.
						When enabled (default), copy and paste fail beyond Max reach distance.
						'''
				}

				MaxReachDistanceTiles: {
					Label: Max reach distance (host default)
					Tooltip: Chebyshev tile distance used when host safeguard defaults apply. Default 200. Still clamped by Max reach distance cap.
				}

				MaxReachDistanceTilesCap: {
					Label: Max reach distance cap
					Tooltip: Absolute ceiling for any client's Max reach distance preference. Server / host. Default 5000.
				}
			}

			Server: {
				Label: Server limits
				Tooltip: Server-wide execution caps shared by every paste operation. Server / host owned.

				ServerOperationLimit: {
					Label: Server operation limit
					Tooltip: Maximum concurrent paste operations across all players on this world. Server / host. Default 8.
				}

				MaxPhaseTickSize: {
					Label: Max phase tick size
					Tooltip: Hard ceiling for any phase Tick size (plan/clear/cut/place/sweep). Server / host. Default 512.
				}

				MaxTilesPerCategory: {
					Label: Max tiles per category
					Tooltip: Maximum tiles written into one layer category batch for overlay/sync bookkeeping. Server / host. Default 4096.
				}

				MaxConcurrentArrows: {
					Label: Max concurrent arrows
					Tooltip: Maximum paste arrows in flight per operation at once. Higher values look faster but cost more entities. Server / host. Default 64.
				}
			}
		}

		Phases: {
			Label: Phase policy
			Tooltip:
				'''
				Per-phase pacing, host strategy defaults, and whether clients may override those strategies.
				Server / host owned in multiplayer. Sweep, when active, skips Clear/Cut/Place execution.
				'''

			Plan: {
				Label: Plan
				Tooltip: Builds clear, cut, and place task queues before execution. Server / host.

				Active: {
					Label: Active
					Tooltip:
						'''
						When on (default), paste walks the footprint in budgeted Plan ticks before Clear/Cut/Place.
						When off, queues are built in one blind pass without plan-stage filtering.
						Server / host.
						'''
				}

				TickSize: {
					Label: Planning units per tick
					Tooltip: How many planning units to process per Plan tick while building queues. Server / host. Default 50.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay between Plan ticks in milliseconds. Use 0 (default) for no wait. Server / host.
				}

				Strategy: {
					Label: Plan strategy
					Tooltip: Host default for which destination cells are cleared when planning the clear footprint.

					Style: {
						Label: Clear style
						Tooltip:
							'''
							All — clear the full included target footprint.
							Transparent (default) — clear only where payload overlaps the destination.
							Negative — clear only where payload does not overlap.
							Used when Allow client preferences is off; otherwise each client's Plan preference applies.
							Server / host.
							'''
					}
				}

				AllowClientPreferences: {
					Label: Allow client preferences
					Tooltip:
						'''
						When on (default), each client's Plan clear-style preference is used.
						When off, the host Plan strategy Style above is forced for everyone.
						Server / host.
						'''
				}
			}

			Clear: {
				Label: Clear
				Tooltip: Clears destination tiles before placement. Server / host. Skipped when Sweep is active.

				Strategy: {
					Label: Clear strategy
					Tooltip: Host default for how destroyed tiles handle item drops during Clear.

					ItemDrop: {
						Label: Item drop
						Tooltip:
							'''
							Void (default) — destroy tiles without dropping items.
							Drop — spawn normal tile drops in the world.
							Store — route drops into adjacent inventories; overflow drops in the world.
							Used when Allow client preferences is off; otherwise each client's Clear preference applies.
							Server / host.
							'''
					}
				}

				AllowClientPreferences: {
					Label: Allow client preferences
					Tooltip:
						'''
						When on (default), each client's Clear item-drop preference is used.
						When off, the host Clear strategy Item drop above is forced for everyone.
						Server / host.
						'''
				}

				Active: {
					Label: Active
					Tooltip: When off, the Clear execution phase is skipped. Server / host. Default on. Ignored when Sweep is active.
				}

				TickSize: {
					Label: Tasks per tick
					Tooltip: Maximum clear tasks executed per tick. Server / host. Default 100.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay after each clear tick in milliseconds. Server / host. Default 100.
				}
			}

			Cut: {
				Label: Cut
				Tooltip: Clears tiles at the source area for cut-paste. Server / host. Skipped when Sweep is active.

				Strategy: {
					Label: Cut strategy
					Tooltip: Host-only cut behavior that can force a source-area clear during paste.

					EnableCutPasteProcess: {
						Label: Force source clear during paste
						Tooltip:
							'''
							When enabled, paste always plans source-area clear tasks even if the projection Cut flag is off.
							When disabled (default), source clear runs only when the projection requests cut.
							Server / host only — clients cannot override this.
							'''
					}
				}

				Active: {
					Label: Active
					Tooltip: When off, the Cut execution phase is skipped. Server / host. Default on. Ignored when Sweep is active.
				}

				TickSize: {
					Label: Tasks per tick
					Tooltip: Maximum cut tasks executed per tick. Server / host. Default 100.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay after each cut tick in milliseconds. Server / host. Default 100.
				}
			}

			Place: {
				Label: Place
				Tooltip: Places payload tiles at the destination. Server / host. Skipped when Sweep is active.

				Strategy: {
					Label: Place strategy
					Tooltip: Host defaults for inventory rules, retries, and Place vs Replace.

					RequireItems: {
						Label: Require items
						Tooltip:
							'''
							When on (default), placement consumes mapped items from inventory (or fails when missing, subject to retry).
							When off, placement still consults item channels but required stack is 0 and items need not be present.
							Server / host — clients cannot override this.
							'''
					}

					RetryOnMissingItems: {
						Label: Retry on missing items
						Tooltip:
							'''
							When enabled, place tasks that fail for lack of items are requeued instead of skipped.
							When disabled (default), those tiles are skipped so the paste can finish.
							Used as the forced host value when Allow client preferences is off; otherwise a client may opt in.
							Server / host.
							'''
					}

					RetryOnInvalidPlacement: {
						Label: Retry on invalid placement
						Tooltip:
							'''
							When enabled, invalid placements (for example missing support) are retried later.
							When disabled (default), those tiles are skipped so the paste can finish.
							Used as the forced host value when Allow client preferences is off; otherwise a client may opt in.
							Server / host.
							'''
					}

					Style: {
						Label: Placement style
						Tooltip:
							'''
							Place (default) — normal placement without forced replace clears.
							Replace — clear conflicting destination tiles before placing.
							Server / host — clients cannot override this.
							'''
					}
				}

				AllowClientPreferences: {
					Label: Allow client preferences
					Tooltip:
						'''
						When on (default), clients may opt into Retry on missing items and Retry on invalid placement.
						When off, the host Place strategy retry flags above are forced for everyone.
						Require items and Placement style always stay host-owned.
						Server / host.
						'''
				}

				Active: {
					Label: Active
					Tooltip: When off, the Place execution phase is skipped. Server / host. Default on. Ignored when Sweep is active.
				}

				TickSize: {
					Label: Tasks per tick
					Tooltip: Maximum place tasks executed per tick. Server / host. Default 100.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay after each place tick in milliseconds. Server / host. Default 100.
				}
			}

			Sweep: {
				Label: Sweep
				Tooltip:
					'''
					Host-only footprint blit that copies payload tiles directly.
					When active, Clear, Cut, and Place execution are skipped; Plan may still seed the included footprint.
					Off by default. Tick size and tick speed still control sweep batching.
					'''

				Active: {
					Label: Active
					Tooltip:
						'''
						When enabled, paste runs a sweep blit over the included footprint and skips Clear/Cut/Place.
						Server / host only in multiplayer. Default off.
						'''
				}

				TickSize: {
					Label: Batch size
					Tooltip: Maximum sweep tiles applied per tick. Default 512. Use with tick delay for paced blits.
				}

				TickDelayMs: {
					Label: Tick delay (ms)
					Tooltip: Delay after each sweep tick. Use 0 (default) to apply batches as fast as the server ticks.
				}
			}
		}

		LayerPolicy: {
			DisplayName: Layer policy
			Tooltip: Enable or disable task identification per layer. Disabled layers queue no clear or place tasks.

			MainLayers: {
				DisplayName: Main Layers
				Tooltip: Pipeline layers that run directly in the paste queue.

				Wall: {
					Label: Wall
					Tooltip: Wall placement and removal.
				}

				Block: {
					Label: Block
					Tooltip: Standard placed tiles that are not falling, anchored, tree, or unknown tiles.
				}

				Falling: {
					Label: Falling Block
					Tooltip: Falling tiles such as sand, silt, slush, and similar blocks.
				}

				Frame: {
					Label: Frame
					Tooltip: Tiles that require nearby support such as anchors, walls, or mapped base tiles.
				}

				Entity: {
					Label: Entity
					Tooltip:
						'''
						Off by default. After Frame places host tiles, overwrite matching chest, sign, and TileEntity contents from the blueprint entity sidecar without consuming inventory for those contents.
						Replaces the old entity data cheat. Inventory-backed insert/extract via paste arrows is planned separately.
						'''
				}

				Custom: {
					Label: Custom
					Tooltip: Master switch for attributed custom handlers. Individual handler toggles are in Custom Layers.
				}

				Paint: {
					Label: Paint
					Tooltip: Tile and wall paint state.
				}

				Wiring: {
					Label: Wiring
					Tooltip: Wires and actuators.
				}

				Detail: {
					Label: Detail
					Tooltip: Slopes, half-blocks, and actuation state.
				}

				Fluid: {
					Label: Fluid
					Tooltip: Water, lava, honey, and shimmer.
				}

				Unknown: {
					Label: Unknown
					Tooltip: Unknown tile ids, usually from missing or unloaded content.
				}

				Label: Main Layers
			}

			CustomLayers: {
				DisplayName: Custom Layers
				Tooltip: Enable or disable identification for individual attributed custom handlers.

				Plant: {
					Label: Plant
					Tooltip: Surface plants and regrowth tiles (non-grass).
				}

				Vine: {
					Label: Vine
					Tooltip: Hanging and reverse vine columns.
				}

				Tree: {
					Label: Tree
					Tooltip: Trees, gem trees, and cactus.
				}

				Label: Custom Layers
			}

			Label: Layer policy
		}
	}

	ArchitectModeConfig: {
		DisplayName: Architect Mode
		Tooltip:
			'''
			Client utilities for Architect Mode.
			Use the panic toggle if you unlocked the unstable Mode by mistake.
			'''
		Headers.Panic: Panic

		ClearPermanentArchitectModeUnlock: {
			Label: Clear permanent Architect Mode unlock
			Tooltip:
				'''
				One-shot action. Save this config while in a world to remove the permanent unlock from the current character.
				Closes Architect Mode if it is open. Architect's Hand still grants temporary access while equipped.
				'''
		}
	}

	TileMappingConfig: {
		DisplayName: Tile Mapping
		Tooltip:
			'''
			Server/host control panel for mapping discovery and compile.
			Layer toggles control which SourceMaps are included during compile.
			Action toggles are one-shot: set to true and save config to enqueue that action.
			'''

		Headers: {
			TileMapping: Source map layers
			Actions: Actions
		}

		EnablePlacementDiscovery: {
			Label: Placement
			Tooltip: When enabled, Placement.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableCustomInteractionMap: {
			Label: Custom
			Tooltip: When enabled, Custom.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableWandDiscovery: {
			Label: Wand
			Tooltip: When enabled, Wands.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableRubbleDiscovery: {
			Label: Rubble
			Tooltip: When enabled, Rubble.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnablePaintDiscovery: {
			Label: Paint
			Tooltip: When enabled, Paints.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnablePlantDiscovery: {
			Label: Plant
			Tooltip: When enabled, Plants.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableConversionDiscovery: {
			Label: Conversion
			Tooltip: When enabled, Conversion.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableBiomeConversions: {
			Label: Biome
			Tooltip: When enabled, Biome.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		EnableShimmerTransforms: {
			Label: Shimmer
			Tooltip: When enabled, Shimmer.itr.json from SourceMaps is included in the compiled maps. Server / host only in multiplayer.
		}

		CompiledInteractionMapPath: {
			Label: Compiled map path
			Tooltip:
				'''
				Path to the compiled InteractionMap used for paste lookups.
				Leave empty to use CompiledMaps/InteractionMap.itr (and its .itr.json sibling).
				Relative paths are resolved from the mod directory; absolute paths are used as-is.
				Examples: CompiledMaps/VanillaMap.itr, CompiledMaps/ModdedMap.itr
				Compile still always writes CompiledMaps/InteractionMap.itr.
				Server / host only in multiplayer.
				'''
		}

		RunPlacementDiscovery: {
			Label: Run placement discovery
			Tooltip: One-shot action. Save config with this enabled to run placement discovery.
		}

		RunWandDiscovery: {
			Label: Run wand discovery
			Tooltip: One-shot action. Save config with this enabled to run wand discovery.
		}

		RunRubbleDiscovery: {
			Label: Run rubble discovery
			Tooltip: One-shot action. Save config with this enabled to run rubble discovery.
		}

		RunPaintDiscovery: {
			Label: Run paint discovery
			Tooltip: One-shot action. Save config with this enabled to run paint discovery.
		}

		RunPlantDiscovery: {
			Label: Run plant discovery
			Tooltip: One-shot action. Save config with this enabled to run plant discovery.
		}

		RunConversionDiscovery: {
			Label: Run conversion discovery
			Tooltip: One-shot action. Save config with this enabled to run conversion discovery.
		}

		RunBiomeDiscovery: {
			Label: Run biome discovery
			Tooltip: One-shot action. Save config with this enabled to run biome discovery.
		}

		RunShimmerDiscovery: {
			Label: Run shimmer discovery
			Tooltip: One-shot action. Save config with this enabled to run shimmer discovery.
		}

		RunCompileNow: {
			Label: Compile mapping now
			Tooltip: One-shot action. Save config with this enabled to compile interaction maps now.
		}

		RunFullDiscoveryAndCompile: {
			Label: Run full discovery + compile
			Tooltip: One-shot action. Save config with this enabled to run placement, wand, plant, conversion, biome, shimmer discovery, then compile.
		}
	}

