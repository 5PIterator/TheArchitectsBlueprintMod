	ClearPhaseStrategy: {
		Tooltip: Legacy clear-area style names. Prefer ClearStyle.

		All: {
			Label: All
			Tooltip: Clear the full target footprint.
		}

		Transparent: {
			Label: Transparent
			Tooltip: Clear only where payload overlaps the destination.
		}

		Negative: {
			Label: Negative
			Tooltip: Clear only where payload does not overlap.
		}
	}

	PlacementStyle: {
		Tooltip: Legacy place-style names. Prefer PlaceStyle.

		Place: {
			Label: Place
			Tooltip: Normal placement without forced replace clears.
		}

		Replace: {
			Label: Replace
			Tooltip: Clear conflicting tiles before placing.
		}
	}

	PlanPhaseStrategies: {
		Tooltip: Host Plan clear-footprint style. Used when client plan preferences are disallowed.

		Style: {
			Label: Clear style
			Tooltip:
				'''
				All — clear the full included target footprint.
				Transparent (default) — clear only where payload overlaps.
				Negative — clear only where payload does not overlap.
				'''
		}
	}

	ClearPhaseStrategies: {
		Tooltip: Host Clear item-drop style. Used when client clear preferences are disallowed.

		ItemDrop: {
			Label: Item drop
			Tooltip:
				'''
				Void (default) — destroy without drops.
				Drop — spawn world drops.
				Store — route into adjacent inventories; overflow drops in the world.
				'''
		}
	}

	PlacePhaseStrategies: {
		Tooltip: Host Place inventory, retry, and Place/Replace defaults. Server / host.

		RequireItems: {
			Label: Require items
			Tooltip: When on (default), consume mapped items while placing. When off, required stack is 0. Host-owned.
		}

		RetryOnMissingItems: {
			Label: Retry on missing items
			Tooltip: Requeue place tasks that fail for missing items instead of skipping. Default off. Clients may opt in when allowed.
		}

		RetryOnInvalidPlacement: {
			Label: Retry on invalid placement
			Tooltip: Retry invalid placements instead of skipping. Default off. Clients may opt in when allowed.
		}

		PlacementStyle: {
			Label: Placement style
			Tooltip: Place (default) or Replace. Host-owned.
		}

		Style: {
			Label: Placement style
			Tooltip: Place (default) — normal placement. Replace — clear conflicts first. Host-owned.
		}
	}

	PastePhaseTuning: {
		Tooltip: Legacy phase pacing fields. Prefer TickSize / TickSpeed on phase configs.

		Active: {
			Label: Active
			Tooltip: When off, this phase is skipped.
		}

		StepSize: {
			Label: Step size
			Tooltip: Tasks processed per step.
		}

		DelayMs: {
			Label: Delay ms
			Tooltip: Delay between steps in milliseconds.
		}

		SingleTick: {
			Label: Single tick
			Tooltip: When on, the phase attempts to finish in one tick.
		}
	}

	PastePhaseSettings: {
		Tooltip: Legacy phase pacing fields. Prefer the phase configs under Paste policy.

		Active: {
			Label: Active
			Tooltip: When off, this phase is skipped.
		}

		TickSize: {
			Label: Tick size
			Tooltip: Maximum tasks processed per tick.
		}

		TickDelayMs: {
			Label: Tick delay ms
			Tooltip: Delay after each tick in milliseconds.
		}
	}

	GlobalLimitsConfig: {
		Tooltip: Global paste caps grouped by client vs server enforcement. Server / host.

		Client: {
			Label: Client
			Tooltip: Per-client caps and safeguard gates enforced on requests and validation.
		}

		Server: {
			Label: Server
			Tooltip: Server-wide execution caps.
		}
	}

	ClientPasteLimitsConfig: {
		Tooltip: Per-client paste caps and safeguard gates. Server / host owned in multiplayer.

		MaxPasteWidth: {
			Label: Max paste width
			Tooltip: Maximum projection width in tiles. Default 200.
		}

		MaxPasteHeight: {
			Label: Max paste height
			Tooltip: Maximum projection height in tiles. Default 200.
		}

		VolumeLimit: {
			Label: Volume limit
			Tooltip: Maximum number of cells in a single paste. Default 5000.
		}

		PlayerOperationLimit: {
			Label: Player operation limit
			Tooltip: Maximum concurrent paste operations per player. Default 1.
		}

		AllowClientSafeguardPreferences: {
			Label: Allow client safeguard preferences
			Tooltip: When enabled (default), honor each client's Safeguards prefs clamped by Max reach distance cap.
		}

		RestrictCopyAndPasteToRevealedTiles: {
			Label: Require explored map tiles
			Tooltip: Host default when client safeguard prefs are disallowed. Default on.
		}

		LimitCopyAndPasteToPlayerReach: {
			Label: Limit to player reach
			Tooltip: Host default when client safeguard prefs are disallowed. Default on.
		}

		MaxReachDistanceTiles: {
			Label: Max reach distance
			Tooltip: Host default reach distance in tiles. Default 200.
		}

		MaxReachDistanceTilesCap: {
			Label: Max reach distance cap
			Tooltip: Absolute ceiling for client Max reach distance. Default 5000.
		}
	}

	ServerPasteLimitsConfig: {
		Tooltip: Server-wide execution caps. Server / host.

		ServerOperationLimit: {
			Label: Server operation limit
			Tooltip: Maximum concurrent paste operations on the server. Default 8.
		}

		MaxPhaseTickSize: {
			Label: Max phase tick size
			Tooltip: Upper bound for tasks or planning units processed per tick in any phase. Default 512.
		}

		MaxTilesPerCategory: {
			Label: Max tiles per category
			Tooltip: Maximum tiles processed per layer category in a single step. Default 4096.
		}

		MaxConcurrentArrows: {
			Label: Max concurrent arrows
			Tooltip: Maximum paste arrows in flight per operation at once. Default 64.
		}
	}

	PhasePolicyConfig: {
		Tooltip: Per-phase execution, strategy defaults, and client preference policy. Server / host.

		Plan: {
			Label: Plan
			Tooltip: Builds clear, cut, and place task queues before execution.
		}

		Clear: {
			Label: Clear
			Tooltip: Clears destination tiles before placement.
		}

		Cut: {
			Label: Cut
			Tooltip: Clears tiles at the source area for cut-paste.
		}

		Place: {
			Label: Place
			Tooltip: Places payload tiles at the destination.
		}

		Sweep: {
			Label: Sweep
			Tooltip: Host-only footprint blit. When active, Clear/Cut/Place execution are skipped.
		}
	}

	PlacePhaseConfig: {
