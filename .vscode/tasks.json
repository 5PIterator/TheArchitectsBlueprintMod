{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-mod",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/TheArchitectsBlueprintMod.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		}
	]
}
