{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "C#: Terraria (Menu)",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}\\TheArchitectsBlueprintMod.csproj",
			"launchConfigurationId": "TargetFramework=;TerrariaMenu"
		},
		{
			"name": "C#: Terraria (World)",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}\\TheArchitectsBlueprintMod.csproj",
			"launchConfigurationId": "TargetFramework=;TerrariaWorld"
		},
		{
			"name": "C#: TerrariaServer",
			"type": "dotnet",
			"request": "launch",
			"projectPath": "${workspaceFolder}\\TheArchitectsBlueprintMod.csproj",
			"launchConfigurationId": "TargetFramework=;TerrariaServer"
		},
		{
			"name": "TerrariaServer (no build)",
			"type": "coreclr",
			"request": "launch",
			"program": "dotnet",
			"args": [
				"tModLoader.dll",
				"-server",
				"-world",
				"${config:tml.worldPath}"
			],
			"cwd": "${config:tml.steamPath}",
			"console": "externalTerminal",
			"stopAtEntry": false
		},
		{
			"name": "Terraria Menu (no build)",
			"type": "coreclr",
			"request": "launch",
			"program": "dotnet",
			"args": ["tModLoader.dll"],
			"cwd": "${config:tml.steamPath}",
			"console": "externalTerminal",
			"stopAtEntry": false
		},
		{
			"name": "Terraria World (no build)",
			"type": "coreclr",
			"request": "launch",
			"program": "dotnet",
			"args": ["tModLoader.dll", "-skipselect", "TASTest:TASTest"],
			"cwd": "${config:tml.steamPath}",
			"console": "externalTerminal",
			"stopAtEntry": false
		}
	],
	"compounds": [
		{
			"name": "Paste Net: Server + Client (Menu)",
			"configurations": [
				"TerrariaServer (no build)",
				"Terraria Menu (no build)"
			],
			"preLaunchTask": "build-mod",
			"stopAll": true
		}
	]
}
